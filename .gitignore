# Lista de permissões para os documentos brutos.
# O verificador do manifesto também rejeita arquivos rastreados fora desta lista.
/data/raw/*
!/data/raw/*/
/data/raw/*/*
!/data/raw/*/original.html
!/data/raw/*/conferencia.pdf
!/data/raw/*/original.xml